# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=

# Client-side OMDB (existing movie browsing UI)
VITE_OMDB_API_KEY=
VITE_OMDB_BASE_URL=

# Server-side OMDB (preferred for AI tools — not exposed to browser)
OMDB_API_KEY=
OMDB_BASE_URL=

# Firebase (client)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# AI provider (server-side preferred)
AI_API_KEY=
AI_MODEL=z-ai/glm-5.2:free
OPENROUTER_API_KEY=

# Local dev fallback only — server routes also read these if AI_API_KEY is unset
VITE_AI_API_KEY=
VITE_AI_MODEL=z-ai/glm-5.2:free

# Dev-only sabotage (never enable in production)
# TEST_RATE_LIMIT=true
# TOOL_SABOTAGE=true
# VITE_CHAT_SABOTAGE=rate-limit
# VITE_CHAT_SABOTAGE=stream-fail
